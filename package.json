{
  "name": "deepseek-balance-checker",
  "displayName": "DeepSeek Balance Checker",
  "description": "Show DeepSeek API account balance in the VS Code status bar",
  "version": "0.0.2",
  "publisher": "MrGaang",
  "repository": {
    "type": "git",
    "url": "https://github.com/FosterG4/Deepseek-balance-vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekBalance.refresh",
        "title": "DeepSeek Balance: Refresh Now"
      },
      {
        "command": "deepseekBalance.configure",
        "title": "DeepSeek Balance: Set API Key"
      }
    ],
    "configuration": {
      "title": "DeepSeek Balance",
      "properties": {
        "deepseekBalance.refreshInterval": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "Refresh interval in seconds (minimum: 30)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  }
}
